# PT Muda Kreasi Teknologi - Backend Environment Configuration

APP_ENV=development
SERVICE_NAME=pt-muda-backend
HTTP_ADDR=127.0.0.1:8091
LOG_DIR=./logs

# PostgreSQL Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pt_muda_kreasi?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT=5s
DB_HEALTH_TIMEOUT=2s

# HTTP Transport & Security
HTTP_REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8091
TRUSTED_PROXIES=127.0.0.1,::1
FRONTEND_PUBLIC_URL=http://localhost:3000

# Session & Cookies
SESSION_COOKIE_NAME=pmkt_refresh
COOKIE_SECURE=false

# Bootstrap Super Admin (for cmd/bootstrap-admin)
BOOTSTRAP_ADMIN_NAME=Super Administrator
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_EMAIL=admin@ptmuda.tech
BOOTSTRAP_ADMIN_PASSWORD=SuperAdminPass2026!
